{
  "name": "deepseek-code-generator",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.3.0",
  "author": "David Dai",
  "publisher": "DavidDai",
  "icon": "media/deepseek-color-128.png",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "type": "object",
      "properties": {
        "deepseek.provider": {
          "type": "string",
          "enum": [
            "deepseek",
            "volcengine",
            "siliconflow",
            "ollama",
            "banma"
          ],
          "default": "banma",
          "description": "%config.provider.description%"
        },
        "deepseek.banmaModel": {
          "type": "string",
          "default": "deepseek-reasoner",
          "description": "%config.banmaModel.description%"
        },
        "deepseek.apiKey": {
          "type": "string",
          "default": "",
          "description": "%config.apiKey.description%"
        },
        "deepseek.ollamaEndpoint": {
          "type": "string",
          "default": "http://203.83.237.172:11434",
          "description": "%config.ollamaEndpoint.description%"
        },
        "deepseek.ollamaModel": {
          "type": "string",
          "default": "deepseek-r1:32b",
          "description": "%config.ollamaModel.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseekContainer",
          "title": "%views.container.title%",
          "icon": "media/deepseek.svg",
          "when": "view == deepseekContainer"
        }
      ]
    },
    "views": {
      "deepseekContainer": [
        {
          "id": "deepseekView",
          "name": "%views.deepseekView.name%",
          "type": "webview",
          "contextualTitle": "%views.deepseekView.contextualTitle%"
        }
      ],
      "explorer": [
        {
          "id": "deepseekExplorer",
          "name": "%views.explorer.deepseekExplorer.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.deekseek",
        "title": "%commands.deekseek.title%",
        "category": "%commands.category%"
      },
      {
        "command": "extension.toggleToDeepseekView",
        "title": "%commands.toggleView.title%",
        "category": "%commands.category%"
      }
    ],
    "keybindings": [
      {
        "command": "extension.deekseek",
        "key": "ctrl+alt+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.toggleToDeepseekView",
        "key": "ctrl+alt+v",
        "mac": "cmd+shift+v"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/vscode": "~1.75.0",
    "eslint": "^8.0.1",
    "typescript": "~5.6.2"
  }
}
