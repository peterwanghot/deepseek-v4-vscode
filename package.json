{
  "name": "deepseek-code-generator",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "2.0.1",
  "author": "Peter",
  "publisher": "DavidDai",
  "repository": {
    "type": "git",
    "url": "https://github.com/peterwanghot/deepseek-v4-vscode.git"
  },
  "icon": "media/deepseek-color-128.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "type": "object",
      "properties": {
        "deepseek.model": {
          "type": "string",
          "enum": [
            "deepseek-v4-flash",
            "deepseek-v4-pro"
          ],
          "default": "deepseek-v4-flash",
          "description": "%config.model.description%"
        },
        "deepseek.apiKey": {
          "type": "string",
          "default": "",
          "description": "%config.apiKey.description%"
        },
        "deepseek.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "%config.baseUrl.description%"
        },
        "deepseek.maxTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 256,
          "maximum": 8192,
          "description": "%config.maxTokens.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseekContainer",
          "title": "%views.container.title%",
          "icon": "media/deepseek.svg",
          "when": "view == deepseekContainer"
        }
      ]
    },
    "views": {
      "deepseekContainer": [
        {
          "id": "deepseekView",
          "name": "%views.deepseekView.name%",
          "type": "webview",
          "contextualTitle": "%views.deepseekView.contextualTitle%"
        }
      ],
      "explorer": [
        {
          "id": "deepseekExplorer",
          "name": "%views.explorer.deepseekExplorer.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.deekseek",
        "title": "%commands.deekseek.title%",
        "category": "%commands.category%"
      },
      {
        "command": "extension.deepseek.explainSelection",
        "title": "%commands.explainSelection.title%",
        "category": "%commands.category%"
      },
      {
        "command": "extension.deepseek.refactorSelection",
        "title": "%commands.refactorSelection.title%",
        "category": "%commands.category%"
      },
      {
        "command": "extension.deepseek.fixSelection",
        "title": "%commands.fixSelection.title%",
        "category": "%commands.category%"
      },
      {
        "command": "extension.deepseek.generateComments",
        "title": "%commands.generateComments.title%",
        "category": "%commands.category%"
      },
      {
        "command": "extension.deepseek.generateTests",
        "title": "%commands.generateTests.title%",
        "category": "%commands.category%"
      },
      {
        "command": "extension.deepseek.reviewSelection",
        "title": "%commands.reviewSelection.title%",
        "category": "%commands.category%"
      },
      {
        "command": "extension.toggleToDeepseekView",
        "title": "%commands.toggleView.title%",
        "category": "%commands.category%"
      }
    ],
    "submenus": [
      {
        "id": "deepseek.editorContext",
        "label": "%menus.deepseekContext.title%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "deepseek.editorContext",
          "group": "deepseek@1",
          "when": "editorHasSelection"
        }
      ],
      "deepseek.editorContext": [
        {
          "command": "extension.deepseek.explainSelection",
          "group": "deepseek@1"
        },
        {
          "command": "extension.deepseek.refactorSelection",
          "group": "deepseek@2"
        },
        {
          "command": "extension.deepseek.fixSelection",
          "group": "deepseek@3"
        },
        {
          "command": "extension.deepseek.generateComments",
          "group": "deepseek@4"
        },
        {
          "command": "extension.deepseek.generateTests",
          "group": "deepseek@5"
        },
        {
          "command": "extension.deepseek.reviewSelection",
          "group": "deepseek@6"
        }
      ]
    },
    "keybindings": [
      {
        "command": "extension.deekseek",
        "key": "ctrl+alt+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.toggleToDeepseekView",
        "key": "ctrl+alt+v",
        "mac": "cmd+shift+v"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "npm run compile && vscode-test"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/vscode": "~1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.0.1",
    "typescript": "~5.6.2"
  }
}
